<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_bg_detail"
    android:padding="16dp">

    <include layout="@layout/title_sms" />

    <!-- 卡片容器 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="30dp"
        android:background="@drawable/glass_card"
        android:padding="16dp"
        android:layout_marginTop="8dp"
        android:elevation="6dp">

        <!-- 收信时间 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="收信时间"
            android:textSize="14sp"
            android:textColor="@color/gray"/>

        <TextView
            android:id="@+id/detail_datetime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="这里填写收信时间"
            android:layout_margin="10dp"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:paddingBottom="8dp"/>

        <View android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/light_gray"
            android:layout_marginBottom="8dp"/>

        <!-- 发信人 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发信人"
            android:textSize="14sp"
            android:textColor="@color/gray"/>

        <TextView
            android:id="@+id/detail_sender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="这里填写发信人"
            android:layout_margin="10dp"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:paddingBottom="8dp"/>

        <View android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/light_gray"
            android:layout_marginBottom="8dp"/>

        <!-- 短信内容 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="短信内容"
            android:textSize="14sp"
            android:textColor="@color/gray"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_margin="10dp">
            <TextView
                android:id="@+id/detail_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="这里填写需要检测的信息"
                android:textSize="17sp"
                android:textColor="@color/white"
                android:paddingBottom="8dp"/>
        </ScrollView>

        <View android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/light_gray"
            android:layout_marginBottom="8dp"/>

        <!-- 检测结果 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="检测结果"
            android:textSize="14sp"
            android:textColor="@color/gray"/>

        <TextView
            android:id="@+id/detail_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="这里显示短信类型"
            android:layout_margin="10dp"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:paddingBottom="8dp"/>

        <Button
            android:id="@+id/detail_btn"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="查看详情"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:background="@drawable/neon_button"/>

        <ScrollView
            android:id="@+id/detail_scroll"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_margin="10dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/detail_result"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="检测详情"
                android:textSize="17sp"
                android:textColor="@color/white"/>
        </ScrollView>


        <!-- 反馈功能区域 -->
        <LinearLayout
            android:id="@+id/feedbackSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="@drawable/glass_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤔 系统识别错了吗？请帮我们改进！"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="5dp" />

            <RadioGroup
                android:id="@+id/feedbackGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <RadioButton
                    android:id="@+id/radio_correct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="识别正确 ✅" />

                <RadioButton
                    android:id="@+id/radio_wrong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="识别错误 ❗" />
            </RadioGroup>

            <EditText
                android:id="@+id/feedbackComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="补充你的理由（可选）"
                android:background="@android:drawable/edit_text"
                android:padding="8dp"
                android:minHeight="60dp"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/submitFeedbackBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="提交反馈"
                android:background="@drawable/neon_button"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
